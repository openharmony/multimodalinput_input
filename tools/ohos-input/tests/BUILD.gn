import("//build/test.gni")
import("../../../multimodalinput_mini.gni")

module_output_path = "input/input"

ohos_unittest("OhosInputCommandTest") {
  module_out_path = module_output_path

  sources = [
    "../src/executor.cpp",
    "../src/key_press_command.cpp",
    "../src/modifier.cpp",
    "../src/option_parser.cpp",
    "../src/printer.cpp",
    "command_table_test.cpp",
    "executor_test.cpp",
    "integration_test.cpp",
    "mock_controller_factory.cpp",
    "modifier_test.cpp",
    "option_parser_test.cpp",
    "printer_test.cpp",
  ]

  include_dirs = [
    "../include",
    "${mmi_path}/frameworks/proxy/event_handler/include",
    "${mmi_path}/interfaces/native/innerkits/event/include",
    "${mmi_path}/interfaces/native/innerkits/proxy/include",
    "${mmi_path}/util/common/include",
  ]

  deps = [ "${mmi_path}/frameworks/proxy:libmmi-client" ]

  external_deps = [
    "hilog:libhilog",
    "ipc:ipc_single",
    "json:nlohmann_json_static",
  ]
}

group("unittest") {
  testonly = true
  deps = [
    ":OhosInputCommandTest",
  ]
}
