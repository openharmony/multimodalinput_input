{
  "name": "ohos-input",
  "version": "1.0.0",
  "description": "Keyboard and mouse input simulation tool. Used for AI Agent applications to simulate keyboard and mouse operations on devices. Only supported on PC products.",
  "executablePath": "/system/bin/cli_tool/executable/ohos-input",
  "requirePermissions": [
    "ohos.permission.CONTROL_DEVICE"
  ],
  "inputSchema": {
    "type": "object",
    "properties": {}
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "description": "Executed action name"
      }
    }
  },
  "hasSubCommand": true,
  "subcommands": {
    "mouse-click": {
      "description": "Simulate a mouse click at specified position. Used for single click with optional modifier keys. Does not support multi-button click simultaneously.",
      "requirePermissions": [
        "ohos.permission.CONTROL_DEVICE"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "displayId": {
            "type": "integer",
            "description": "Display ID",
            "minimum": 0,
            "default": 0
          },
          "x": {
            "type": "integer",
            "description": "Target X coordinate (required)",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "description": "Target Y coordinate (required)",
            "minimum": 0
          },
          "button": {
            "type": "string",
            "description": "Mouse button to click",
            "enum": ["left", "right", "middle"],
            "default": "left"
          },
          "holdDuration": {
            "type": "integer",
            "description": "Duration to hold the button in milliseconds",
            "minimum": 50,
            "maximum": 200,
            "default": 100
          },
          "modifier": {
            "type": "string",
            "description": "Modifier keys to hold, pipe-separated (e.g. ctrl|shift). Values: ctrl, alt, shift, meta. Pressed in order, released in reverse. No duplicates.",
            "pattern": "^(ctrl|alt|shift|meta)(\\|(ctrl|alt|shift|meta))*$"
          }
        },
        "required": ["x", "y"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "Executed action name"
          },
          "displayId": {
            "type": "integer",
            "description": "Target display ID"
          },
          "x": {
            "type": "integer",
            "description": "Target X coordinate"
          },
          "y": {
            "type": "integer",
            "description": "Target Y coordinate"
          }
        },
        "required": ["action", "displayId", "x", "y"]
      }
    },
    "mouse-double-click": {
      "description": "Simulate a mouse double-click at specified position. Used for double click with optional modifier keys. Does not support multi-button double-click simultaneously.",
      "requirePermissions": [
        "ohos.permission.CONTROL_DEVICE"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "displayId": {
            "type": "integer",
            "description": "Display ID",
            "minimum": 0,
            "default": 0
          },
          "x": {
            "type": "integer",
            "description": "Target X coordinate (required)",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "description": "Target Y coordinate (required)",
            "minimum": 0
          },
          "button": {
            "type": "string",
            "description": "Mouse button to double-click",
            "enum": ["left", "right", "middle"],
            "default": "left"
          },
          "holdDuration": {
            "type": "integer",
            "description": "Duration to hold the button in milliseconds for each click",
            "minimum": 50,
            "maximum": 200,
            "default": 100
          },
          "clickInterval": {
            "type": "integer",
            "description": "Time interval between the first button press and the second button press in milliseconds. Must be greater than holdDuration.",
            "minimum": 100,
            "maximum": 400,
            "default": 250
          },
          "modifier": {
            "type": "string",
            "description": "Modifier keys to hold, pipe-separated (e.g. ctrl|shift). Values: ctrl, alt, shift, meta. Pressed in order, released in reverse. No duplicates.",
            "pattern": "^(ctrl|alt|shift|meta)(\\|(ctrl|alt|shift|meta))*$"
          }
        },
        "required": ["x", "y"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "Executed action name"
          },
          "displayId": {
            "type": "integer",
            "description": "Target display ID"
          },
          "x": {
            "type": "integer",
            "description": "Target X coordinate"
          },
          "y": {
            "type": "integer",
            "description": "Target Y coordinate"
          }
        },
        "required": ["action", "displayId", "x", "y"]
      }
    },
    "mouse-scroll": {
      "description": "Simulate vertical mouse scroll. Only vertical scroll is supported, horizontal scroll is not supported. 1 click = 15 degrees. Used with optional modifier keys.",
      "requirePermissions": [
        "ohos.permission.CONTROL_DEVICE"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "clicks": {
            "type": "integer",
            "description": "Number of scroll clicks (required, positive for scroll up, negative for scroll down, non-zero). 1 click = 15 degrees.",
            "minimum": -100,
            "maximum": 100
          },
          "modifier": {
            "type": "string",
            "description": "Modifier keys to hold, pipe-separated (e.g. ctrl|shift). Values: ctrl, alt, shift, meta. Pressed in order, released in reverse. No duplicates.",
            "pattern": "^(ctrl|alt|shift|meta)(\\|(ctrl|alt|shift|meta))*$"
          }
        },
        "required": ["clicks"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "Executed action name"
          },
          "clicks": {
            "type": "integer",
            "description": "Number of scroll clicks executed"
          }
        },
        "required": ["action", "clicks"]
      }
    },
    "mouse-move": {
      "description": "Move mouse cursor to specified position. Used for repositioning the cursor with optional modifier keys. Does not support clicking during movement.",
      "requirePermissions": [
        "ohos.permission.CONTROL_DEVICE"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "displayId": {
            "type": "integer",
            "description": "Display ID",
            "minimum": 0,
            "default": 0
          },
          "x": {
            "type": "integer",
            "description": "Target X coordinate (required)",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "description": "Target Y coordinate (required)",
            "minimum": 0
          },
          "modifier": {
            "type": "string",
            "description": "Modifier keys to hold, pipe-separated (e.g. ctrl|shift). Values: ctrl, alt, shift, meta. Pressed in order, released in reverse. No duplicates.",
            "pattern": "^(ctrl|alt|shift|meta)(\\|(ctrl|alt|shift|meta))*$"
          }
        },
        "required": ["x", "y"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "Executed action name"
          },
          "displayId": {
            "type": "integer",
            "description": "Target display ID"
          },
          "x": {
            "type": "integer",
            "description": "Target X coordinate"
          },
          "y": {
            "type": "integer",
            "description": "Target Y coordinate"
          }
        },
        "required": ["action", "displayId", "x", "y"]
      }
    },
    "mouse-drag": {
      "description": "Simulate mouse drag from source to destination. Used for dragging objects between positions. Does not support drag duration exceeding 10 seconds.",
      "requirePermissions": [
        "ohos.permission.CONTROL_DEVICE"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "srcDisplayId": {
            "type": "integer",
            "description": "Source display ID",
            "minimum": 0,
            "default": 0
          },
          "srcX": {
            "type": "integer",
            "description": "Source X coordinate (required)",
            "minimum": 0
          },
          "srcY": {
            "type": "integer",
            "description": "Source Y coordinate (required)",
            "minimum": 0
          },
          "dstDisplayId": {
            "type": "integer",
            "description": "Destination display ID",
            "minimum": 0,
            "default": 0
          },
          "dstX": {
            "type": "integer",
            "description": "Destination X coordinate (required)",
            "minimum": 0
          },
          "dstY": {
            "type": "integer",
            "description": "Destination Y coordinate (required)",
            "minimum": 0
          },
          "button": {
            "type": "string",
            "description": "Mouse button to hold during drag",
            "enum": ["left", "right", "middle"],
            "default": "left"
          },
          "duration": {
            "type": "integer",
            "description": "Total drag duration in milliseconds. 0 means instant completion. Default: 0",
            "minimum": 0,
            "maximum": 10000,
            "default": 0
          },
          "modifier": {
            "type": "string",
            "description": "Modifier keys to hold, pipe-separated (e.g. ctrl|shift). Values: ctrl, alt, shift, meta. Pressed in order, released in reverse. No duplicates.",
            "pattern": "^(ctrl|alt|shift|meta)(\\|(ctrl|alt|shift|meta))*$"
          }
        },
        "required": ["srcX", "srcY", "dstX", "dstY"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "Executed action name"
          },
          "srcDisplayId": {
            "type": "integer",
            "description": "Source display ID"
          },
          "srcX": {
            "type": "integer",
            "description": "Source X coordinate"
          },
          "srcY": {
            "type": "integer",
            "description": "Source Y coordinate"
          },
          "dstDisplayId": {
            "type": "integer",
            "description": "Destination display ID"
          },
          "dstX": {
            "type": "integer",
            "description": "Destination X coordinate"
          },
          "dstY": {
            "type": "integer",
            "description": "Destination Y coordinate"
          }
        },
        "required": ["action", "srcDisplayId", "srcX", "srcY", "dstDisplayId", "dstX", "dstY"]
      }
    },
    "key-press": {
      "description": "Simulate a key press with specified duration. Used for single key press with optional modifier keys. Does not support multiple non-modifier keys simultaneously.",
      "requirePermissions": [
        "ohos.permission.CONTROL_DEVICE"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "integer",
            "description": "Key code to press (required, refer to OHOS key code definitions)",
            "minimum": 1
          },
          "holdDuration": {
            "type": "integer",
            "description": "Duration to hold the key in milliseconds. 0 means instant release.",
            "minimum": 0,
            "maximum": 10000,
            "default": 100
          },
          "modifier": {
            "type": "string",
            "description": "Modifier keys to hold, pipe-separated (e.g. ctrl|shift). Values: ctrl, alt, shift, meta. Pressed in order, released in reverse. No duplicates.",
            "pattern": "^(ctrl|alt|shift|meta)(\\|(ctrl|alt|shift|meta))*$"
          }
        },
        "required": ["key"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "Executed action name"
          },
          "key": {
            "type": "integer",
            "description": "Key code pressed"
          }
        },
        "required": ["action", "key"]
      }
    }
  }
}
